{
    "id": 16,
    "name": "multiPurposeShield",
    "agents": [
        {
            "archClass": "jason.Argo",
            "name": "bob",
            "sourceCode": "serialPort(ttyUSB0). /* /dev/ttyUSB0 on Linux. Adjust this belief if necessarry */\n\n!connect.\n!helloWorld.\n\n+!connect: serialPort(Port) <- \n\t.port(Port); \n\t.limit(500); \n\t.percepts(open).\n\n+!helloWorld: port(P,Status) <-\n\t.act(ledRedOn);\t    .wait(1000);\n\t.act(ledRedOff);\t.wait(1000);\n\t\n\t.act(ledBlueOn);\t.wait(1000);\n\t.act(ledBlueOff);\t.wait(1000);\n\n\t.act(buzzerOn);\t    .wait(1000);\n\t.act(buzzerOff);\t.wait(1000);\n\t\n\t.act(rgbWhite);\t    .wait(1000);\n\t.act(rgbGreen);\t    .wait(1000);\n\t.act(rgbBlue);\t    .wait(1000);\n\t.act(rgbRed);\t    .wait(1000);\n\t.act(rgbOff);\t\t.wait(1000);\n.\n\n-!helloWorld[error(no_applicable)] <-\n\t.print(\"Waiting for connecting...\"); .random(R); .wait(5000*R); !helloWorld.\n\n\n+port(Port,Status) <- .print(\"The USB port \",Port,\" is \",Status).\n\n\t\n+button1(S) <- .print(\"Btn 1: \",S).\n+button2(S) <- .print(\"Btn 2: \",S).\n+hum(H) <- .print(\"Humidity is \",H).\n+temp(T) <- .print(\"Temperature is \",T).\n+buzzer(B)  <- .print(\"Buzzer is \",B).\n+blue(V) <- .print(\"Blue Led is \",V).\n+red(V)  <- .print(\"Red Led is \",V).\n+rgb(V)  <- .print(\"RGB Led is \",V).\n+cmd(C)  <- .print(\"Remote control CMD is \",C).\n+lum(L)  <- .print(\"Luminosity is \",L).\n+pot(P) <- .print(\"Potenciometer is \",P).\n\n+port(Port,Status) <- .print(\"The USB port \",Port,\" is \",Status)."
        }
    ],
    "firmwares": [
        {
            "name": "multiPurposeShield",
            "sourceCode": "\n/*\n * Multi-purpose Shield V1\n *\n * https://www.usinainfo.com.br/shieldsexpansores/shield-multifuncoes-hy-m302-para-arduino-com-dht11-lm35-receptor-ir-ldr-leds-buzzer-e-outros-4866.html\n * https://wiki.keyestudio.com/Ks0183_keyestudio_Multi-purpose_Shield_V1\n */\n\n#include <Javino.h>      // https://github.com/chon-group/javino2arduino\n#include <DHT.h>         // https://github.com/adafruit/DHT-sensor-library and https://github.com/adafruit/adafruit_sensor\n#include <IRremote.hpp>  // https://github.com/Arduino-IRremote/Arduino-IRremote\n\n// ==================================================\n// PIN CONFIGURATION\n// ==================================================\n\n#define pinSW1    2\n#define pinSW2    3\n#define pinDHT    4\n#define pinBuzzer 5\n#define pinIR     6\n\n#define pinRGB_R  9\n#define pinRGB_B  10\n#define pinRGB_G  11\n\n#define RedLED    12\n#define BlueLED   13\n\n#define pinPOT    A0\n#define pinLDR    A1\n\n// ==================================================\n// GLOBAL VARIABLES\n// ==================================================\n\nJavino javino;\nDHT dht(pinDHT, DHT11);\n\n// Actuator states\nuint8_t rgbStatus = 0;\n\n// IR event\nuint16_t lastIRCommand = 0;\nbool irReceived = false;\n\n// Button events\nbool button1Pressed = false;\nbool button2Pressed = false;\n\n// Button debounce\nbool lastSW1 = HIGH;\nbool lastSW2 = HIGH;\n\nbool stableSW1 = HIGH;\nbool stableSW2 = HIGH;\n\nunsigned long lastDebounceSW1 = 0;\nunsigned long lastDebounceSW2 = 0;\n\nconst unsigned long DEBOUNCE_DELAY = 30;\n\n// DHT11 cached readings (x10)\nint temperature10 = 0;\nint humidity10 = 0;\n\nbool dhtValid = false;\n\nunsigned long lastDHTRead = 0;\nconst unsigned long DHT_INTERVAL = 2000;\n\n// Shared buffer for numeric perceptions\nchar msg[24];\n\nbool buzzerStatus = false;\nbool buzzerLevel = false;\n\nunsigned long lastBuzzerToggle = 0;\n\nconst unsigned long BUZZER_HALF_PERIOD = 500;\n\n// ==================================================\n// SETUP\n// ==================================================\n\nvoid setup() {\n    confDefaultPinOut();\n    confJavinoCMDs();\n}\n\nvoid confDefaultPinOut() {\n\n    pinMode(pinSW1, INPUT);\n    pinMode(pinSW2, INPUT);\n\n    pinMode(BlueLED, OUTPUT);\n    pinMode(RedLED, OUTPUT);\n    pinMode(pinBuzzer, OUTPUT);\n\n    pinMode(pinRGB_R, OUTPUT);\n    pinMode(pinRGB_G, OUTPUT);\n    pinMode(pinRGB_B, OUTPUT);\n\n    setRGB(0, 0, 0);\n\n    dht.begin();\n    IrReceiver.begin(pinIR, DISABLE_LED_FEEDBACK);\n\n    // Initialize button states\n    lastSW1 = stableSW1 = digitalRead(pinSW1);\n    lastSW2 = stableSW2 = digitalRead(pinSW2);\n}\n\nvoid confJavinoCMDs() {\n\n    // LEDs\n    javino.act[\"ledBlueOn\"]  = ledBlueOn;\n    javino.act[\"ledBlueOff\"] = ledBlueOff;\n    javino.act[\"ledRedOn\"]   = ledRedOn;\n    javino.act[\"ledRedOff\"]  = ledRedOff;\n\n    // RGB\n    javino.act[\"rgbRed\"]   = rgbRed;\n    javino.act[\"rgbGreen\"] = rgbGreen;\n    javino.act[\"rgbBlue\"]  = rgbBlue;\n    javino.act[\"rgbWhite\"] = rgbWhite;\n    javino.act[\"rgbOff\"]   = rgbOff;\n\n    // Buzzer\n    javino.act[\"buzzerOn\"]  = buzzerOn;\n    javino.act[\"buzzerOff\"] = buzzerOff;\n\n    // Perceptions\n    javino.perceive(getExogenousPerceptions);\n    javino.start(9600);\n}\n\n// ==================================================\n// MAIN LOOP\n// ==================================================\n\nvoid loop() {\n    javino.run();\n    readIR();\n    readButtons();\n    readDHT();\n    updateBuzzer();\n    \n}\n\nvoid serialEvent() {\n    javino.readSerial();\n}\n\n// ==================================================\n// EXOGENOUS PERCEPTIONS\n// ==================================================\n\nvoid getExogenousPerceptions() {\n\n    // LEDs\n    javino.addPercept(\n        digitalRead(BlueLED) ?\n        F(\"blue(on)\") : F(\"blue(off)\")\n    );\n\n    javino.addPercept(\n        digitalRead(RedLED) ?\n        F(\"red(on)\") : F(\"red(off)\")\n    );\n\n    // RGB\n    switch (rgbStatus) {\n        case 1:\n            javino.addPercept(F(\"rgb(red)\"));\n            break;\n        case 2:\n            javino.addPercept(F(\"rgb(green)\"));\n            break;\n        case 3:\n            javino.addPercept(F(\"rgb(blue)\"));\n            break;\n        case 4:\n            javino.addPercept(F(\"rgb(white)\"));\n            break;\n        default:\n            javino.addPercept(F(\"rgb(off)\"));\n    }\n\n    // Buzzer\n    javino.addPercept(\n        buzzerStatus ?\n        F(\"buzzer(on)\") :\n        F(\"buzzer(off)\")\n    );\n\n    // Buttons\n    getButtonPercepts();\n\n    // Analog sensors\n    snprintf_P(msg, sizeof(msg),\n        PSTR(\"lum(%d)\"),\n        lerAnalogico(pinLDR));\n    javino.addPercept(msg);\n\n    snprintf_P(msg, sizeof(msg),\n        PSTR(\"pot(%d)\"),\n        lerAnalogico(pinPOT));\n    javino.addPercept(msg);\n\n    // IR\n    getIRPercept();\n\n    // DHT11\n    getDHTPercepts();\n}\n\n// ==================================================\n// BUTTONS - EVENT CAPTURE\n// ==================================================\n\nvoid readButtons() {\n\n    bool sw1 = digitalRead(pinSW1);\n    bool sw2 = digitalRead(pinSW2);\n\n    unsigned long now = millis();\n\n    // Button 1\n    if (sw1 != lastSW1) {\n        lastDebounceSW1 = now;\n    }\n\n    if ((now - lastDebounceSW1) >= DEBOUNCE_DELAY) {\n        if (sw1 != stableSW1) {\n            stableSW1 = sw1;\n\n            if (stableSW1 == LOW) {\n                button1Pressed = true;\n            }\n        }\n    }\n\n    lastSW1 = sw1;\n\n    // Button 2\n    if (sw2 != lastSW2) {\n        lastDebounceSW2 = now;\n    }\n\n    if ((now - lastDebounceSW2) >= DEBOUNCE_DELAY) {\n        if (sw2 != stableSW2) {\n            stableSW2 = sw2;\n\n            if (stableSW2 == LOW) {\n                button2Pressed = true;\n            }\n        }\n    }\n\n    lastSW2 = sw2;\n}\n\n// ==================================================\n// BUTTONS - PERCEPTIONS\n// ==================================================\n\nvoid getButtonPercepts() {\n\n    if (button1Pressed) {\n        javino.addPercept(F(\"button1(pressed)\"));\n        button1Pressed = false;\n    } else {\n        javino.addPercept(F(\"button1(released)\"));\n    }\n\n    if (button2Pressed) {\n        javino.addPercept(F(\"button2(pressed)\"));\n        button2Pressed = false;\n    } else {\n        javino.addPercept(F(\"button2(released)\"));\n    }\n}\n\n// ==================================================\n// IR - EVENT CAPTURE\n// ==================================================\n\nvoid readIR() {\n\n    if (IrReceiver.decode()) {\n\n        if (!(IrReceiver.decodedIRData.flags &\n              IRDATA_FLAGS_IS_REPEAT)) {\n\n            lastIRCommand =\n                IrReceiver.decodedIRData.command;\n\n            irReceived = true;\n        }\n\n        IrReceiver.resume();\n    }\n}\n\n// ==================================================\n// IR - PERCEPTION\n// ==================================================\n\nvoid getIRPercept() {\n\n    if (irReceived) {\n\n        snprintf_P(msg, sizeof(msg),\n            PSTR(\"cmd(%u)\"),\n            lastIRCommand);\n\n        javino.addPercept(msg);\n        irReceived = false;\n\n    } else {\n        javino.addPercept(F(\"cmd(none)\"));\n    }\n}\n\n// ==================================================\n// DHT11 - SENSOR READING\n// ==================================================\n\nvoid readDHT() {\n\n    unsigned long now = millis();\n\n    if (now - lastDHTRead < DHT_INTERVAL) {\n        return;\n    }\n\n    lastDHTRead = now;\n\n    float temp = dht.readTemperature();\n    float humi = dht.readHumidity();\n\n    // Preserve previous values on failure\n    if (isnan(temp) || isnan(humi)) {\n        return;\n    }\n\n    // Update only when both readings are valid\n    temperature10 = (int)round(temp * 10);\n    humidity10 = (int)round(humi * 10);\n\n    dhtValid = true;\n}\n\n// ==================================================\n// DHT11 - PERCEPTIONS\n// ==================================================\n\nvoid getDHTPercepts() {\n\n    if (!dhtValid) {\n        javino.addPercept(F(\"dht(error)\"));\n        return;\n    }\n\n    snprintf_P(msg, sizeof(msg),\n        PSTR(\"temp(%d.%d)\"),\n        temperature10 / 10,\n        abs(temperature10 % 10));\n\n    javino.addPercept(msg);\n\n    snprintf_P(msg, sizeof(msg),\n        PSTR(\"hum(%d.%d)\"),\n        humidity10 / 10,\n        abs(humidity10 % 10));\n\n    javino.addPercept(msg);\n}\n\n// ==================================================\n// LED ACTIONS\n// ==================================================\n\nvoid ledBlueOn() {digitalWrite(BlueLED, HIGH);}\nvoid ledBlueOff() {digitalWrite(BlueLED, LOW);}\nvoid ledRedOn() {digitalWrite(RedLED, HIGH);}\nvoid ledRedOff() {digitalWrite(RedLED, LOW);}\n\n// ==================================================\n// BUZZER ACTIONS\n// ==================================================\n\nvoid buzzerOn() {\n    buzzerStatus = true;\n    buzzerLevel = false;\n    lastBuzzerToggle = micros();\n    digitalWrite(pinBuzzer, LOW);\n}\n\nvoid buzzerOff() {\n    buzzerStatus = false;\n    buzzerLevel = false;\n    digitalWrite(pinBuzzer, LOW);\n}\n\nvoid updateBuzzer() {\n    if (!buzzerStatus) {\n        return;\n    }\n\n    unsigned long now = micros();\n\n    if (now - lastBuzzerToggle >= BUZZER_HALF_PERIOD) {\n        lastBuzzerToggle = now;\n        buzzerLevel = !buzzerLevel;\n        digitalWrite(pinBuzzer, buzzerLevel);\n    }\n}\n\n// ==================================================\n// RGB ACTIONS\n// ==================================================\n\nvoid rgbRed() {setRGB(255, 0, 0);rgbStatus = 1;}\nvoid rgbGreen() {setRGB(0, 255, 0);rgbStatus = 2;}\nvoid rgbBlue() {setRGB(0, 0, 255);rgbStatus = 3;}\nvoid rgbWhite() {setRGB(255, 255, 255);rgbStatus = 4;}\nvoid rgbOff() {setRGB(0, 0, 0);rgbStatus = 0;}\n\n// ==================================================\n// UTILITIES\n// ==================================================\n\nint lerAnalogico(uint8_t pino) {\n    analogRead(pino);\n    delayMicroseconds(200);\n    return analogRead(pino);\n}\n\nvoid setRGB(uint8_t r, uint8_t g, uint8_t b) {\n    analogWrite(pinRGB_R, r);\n    analogWrite(pinRGB_G, g);\n    analogWrite(pinRGB_B, b);\n}\n"
        }
    ]
}
